<Application x:Class="Diktator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="DiktatorAccent" Color="#6D5EF6" />
            <SolidColorBrush x:Key="DiktatorSurface" Color="#1C1C1F" />
            <SolidColorBrush x:Key="DiktatorCard" Color="#252528" />
            <SolidColorBrush x:Key="DiktatorMuted" Color="#8A8A94" />
            <SolidColorBrush x:Key="DiktatorText" Color="#E8E8ED" />
            <SolidColorBrush x:Key="DiktatorError" Color="#FF6B6B" />
            <SolidColorBrush x:Key="DiktatorOk" Color="#3DDC97" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
