<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationTitle>Diktator</ApplicationTitle>
    <StartupObject>Diktator.Program</StartupObject>
    <Version>1.3.0</Version>
    <AssemblyTitle>Diktator</AssemblyTitle>
    <Product>Diktator</Product>
    <Description>Automatische Transkription vom Philips Diktiergerät</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-32.png" />
    <Resource Include="Assets\app-48.png" />
    <Resource Include="Assets\app-64.png" />
    <Resource Include="Assets\diktator-app-icon.png" />
    <Resource Include="Assets\diktator-icon-transparent.png" />
  </ItemGroup>

</Project>
