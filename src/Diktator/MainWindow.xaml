<ui:FluentWindow x:Class="Diktator.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
                 xmlns:local="clr-namespace:Diktator"
                 mc:Ignorable="d"
                 Title="Diktator"
                 Width="760"
                 Height="520"
                 MinWidth="560"
                 MinHeight="400"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Background="#F2111113"
                 ResizeMode="CanResize"
                 ShowInTaskbar="True">

    <ui:FluentWindow.Resources>
        <local:InverseBoolToVisConverter x:Key="InverseBoolToVis" />
        <local:StatusDotConverter x:Key="StatusDot" />
    </ui:FluentWindow.Resources>

    <Grid Background="#F2141416">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <tray:NotifyIcon x:Name="TrayIcon"
                         FocusOnLeftClick="True"
                         MenuOnRightClick="True"
                         TooltipText="Diktator"
                         Icon="pack://application:,,,/Assets/app.png"
                         LeftClick="OnTrayLeftClick">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="Öffnen" Click="OnTrayOpenClick" />
                    <MenuItem Header="Jetzt transkribieren" Click="OnTrayTranscribeClick" />
                    <MenuItem Header="Einstellungen" Click="OnTraySettingsClick" />
                    <Separator />
                    <MenuItem Header="Beenden" Click="OnTrayExitClick" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>

        <ui:TitleBar Grid.Row="0"
                     Title="Diktator"
                     ShowMaximize="False"
                     ForceShutdown="False"
                     CloseClicked="OnTitleBarClose" />

        <Grid Grid.Row="1" Margin="20,4,20,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <ui:Button Appearance="Transparent"
                               ToolTip="Verlauf"
                               Command="{Binding ToggleHistoryCommand}"
                               Padding="8"
                               Margin="0,0,6,0">
                        <ui:SymbolIcon Symbol="TextBulletListLtr24" FontSize="16" />
                    </ui:Button>
                    <Border Background="#E6252528"
                            CornerRadius="14"
                            Padding="10,6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     Margin="2,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding Status, Converter={StaticResource StatusDot}}" />
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="#E8E8ED"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <ui:ProgressRing Margin="10,0,0,0"
                                             Width="14"
                                             Height="14"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Appearance="Transparent"
                               ToolTip="Jetzt transkribieren"
                               Command="{Binding TranscribeNowCommand}"
                               Padding="8">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" />
                    </ui:Button>
                    <ui:Button Appearance="Transparent"
                               ToolTip="Einstellungen"
                               Command="{Binding ToggleSettingsCommand}"
                               Padding="8"
                               Margin="4,0,0,0">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="16" />
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- Transcript + Verlauf -->
            <Grid Grid.Row="1"
                  Visibility="{Binding IsSettingsOpen, Converter={StaticResource InverseBoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="228"
                        Margin="0,0,12,0"
                        Background="#F21C1C1F"
                        CornerRadius="16"
                        Padding="8,10"
                        Visibility="{Binding IsHistoryOpen, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Verlauf"
                                   Foreground="#8A8A94"
                                   FontSize="12"
                                   Margin="8,2,8,8" />
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding History}"
                                 SelectedItem="{Binding SelectedHistory}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBg"
                                                        Background="Transparent"
                                                        CornerRadius="10"
                                                        Padding="10,8">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBg" Property="Background" Value="#33252528" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBg" Property="Background" Value="#336D5EF6" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}"
                                                       Foreground="#E8E8ED"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ListSummary}"
                                                       Foreground="#B0B0B8"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="36"
                                                       Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding WhenLabel}"
                                                       Foreground="#8A8A94"
                                                       FontSize="11"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ui:Button Grid.Column="1"
                                                   Appearance="Transparent"
                                                   Padding="4"
                                                   VerticalAlignment="Center"
                                                   ToolTip="Nach old verschieben"
                                                   Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" />
                                        </ui:Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="1"
                                   Text="Noch keine Transkripte"
                                   Foreground="#8A8A94"
                                   FontSize="12"
                                   Margin="8,4"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="#F21C1C1F"
                        CornerRadius="16"
                        Padding="18,16">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasTranscript, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding Transcript, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#E8E8ED"
                                     CaretBrush="#6D5EF6"
                                     FontSize="16"
                                     FontFamily="Segoe UI Variable Text, Segoe UI"
                                     Padding="0"
                                     AcceptsReturn="True" />
                        </ScrollViewer>

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding HasTranscript, Converter={StaticResource InverseBoolToVis}}">
                            <ui:SymbolIcon Symbol="Mic24"
                                           FontSize="28"
                                           Foreground="#6D5EF6"
                                           HorizontalAlignment="Center" />
                            <TextBlock Text="Warte auf Diktiergerät…"
                                       Foreground="#8A8A94"
                                       FontSize="14"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Settings -->
            <Border Grid.Row="1"
                    Background="#F21C1C1F"
                    CornerRadius="16"
                    Padding="22,18"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Einstellungen"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#E8E8ED"
                                   Margin="0,0,0,16" />

                        <TextBlock Text="Endpunkt"
                                   Foreground="#8A8A94"
                                   FontSize="12"
                                   Margin="0,0,0,6" />
                        <ui:TextBox Text="{Binding SettingsEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="https://…/v1/audio/transcriptions"
                                    Margin="0,0,0,14" />

                        <TextBlock Text="API-Key"
                                   Foreground="#8A8A94"
                                   FontSize="12"
                                   Margin="0,0,0,6" />
                        <ui:PasswordBox Password="{Binding SettingsApiKey, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        PlaceholderText="freellmapi-…"
                                        Margin="0,0,0,14" />

                        <TextBlock Text="Sprache"
                                   Foreground="#8A8A94"
                                   FontSize="12"
                                   Margin="0,0,0,6" />
                        <ui:TextBox Text="{Binding SettingsLanguage, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="de"
                                    Width="80"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,16" />

                        <CheckBox Content="Beim Windows-Start ausführen"
                                  IsChecked="{Binding SettingsAutostart}"
                                  Foreground="#E8E8ED"
                                  Margin="0,0,0,18" />

                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Speichern"
                                       Appearance="Primary"
                                       Command="{Binding SaveSettingsCommand}" />
                            <ui:Button Content="Verbindung testen"
                                       Appearance="Secondary"
                                       Command="{Binding TestConnectionCommand}"
                                       Margin="10,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding SettingsMessage}"
                                   Foreground="#8A8A94"
                                   FontSize="12"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="20,0,20,18">
            <TextBlock Text="{Binding ErrorText}"
                       Foreground="#FF6B6B"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,140,0"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding IsSettingsOpen, Converter={StaticResource InverseBoolToVis}}">
                <ui:Button MinWidth="110"
                           Appearance="Secondary"
                           Content="Löschen"
                           Command="{Binding DeleteCommand}"
                           CommandParameter="{Binding SelectedHistory}"
                           IsEnabled="{Binding HasTranscript}"
                           ToolTip="Datei auf dem Gerät nach old verschieben" />
                <ui:Button MinWidth="120"
                           Appearance="Primary"
                           Content="{Binding CopyButtonText}"
                           Command="{Binding CopyCommand}"
                           IsEnabled="{Binding HasTranscript}"
                           Margin="10,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
